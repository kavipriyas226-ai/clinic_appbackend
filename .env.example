# Copy to `.env` (gitignored) for production-style env-var config, or use
# src/main/resources/application-local.yml for local development instead.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/devsclinic?appName=<appName>
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
